// Cloudflare (Workers con archivos estáticos). SOLO se sube dist/:
// nunca cambies "directory" a "." o se publicaría LEEME.md, los .py, etc.
// Publicar:  python build.py && python publicar.py && wrangler deploy
{
  "name": "montatuserver",
  "compatibility_date": "2026-09-21",
  // El dominio de verdad. Cloudflare crea el certificado solo.
  "routes": [
    { "pattern": "montatuserver.com", "custom_domain": true },
    { "pattern": "www.montatuserver.com", "custom_domain": true }
  ],
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
